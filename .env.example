# DeepSeek API Key (daftar di https://platform.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Aktifkan RAG semantic search berbasis ChromaDB (true/false)
# Default false agar startup lebih cepat
ENABLE_RAG=false

# JWT Secret Key (wajib, generate random string minimal 32 karakter)
SECRET_KEY=your-secret-key-change-this-to-random-string

# Admin Key untuk register petugas (wajib diubah dari default)
ADMIN_KEY=change-me-admin-key

# Allowed CORS origins (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000
